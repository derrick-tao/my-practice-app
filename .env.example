# Azure Speech credentials for running `npm run audio:generate` locally.
# Copy this file to .env (git-ignored) and paste your key. Only the audio command reads .env;
# the app, its build and the tests never do. CI uses the repo secrets of the same names instead.
# Never commit .env, and never give it a VITE_ prefix (that would put the key in the app bundle).
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
