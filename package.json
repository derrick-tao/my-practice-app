{
  "name": "my-practice-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "hanzi-writer": "^3.7.3",
    "preact": "^11.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.5",
    "hanzi-writer-data": "^2.0.1",
    "msedge-tts": "^2.1.0",
    "opencc-js": "^1.4.2",
    "opentype.js": "^2.0.0",
    "pinyin-pro": "^3.29.5",
    "subset-font": "^2.9.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "yaml": "^2.9.1"
  },
  "scripts": {
    "validate": "tsx content-build/cli.ts validate",
    "typecheck": "tsc --noEmit",
    "test:content": "vitest run",
    "content:build": "tsx content-build/cli.ts build",
    "test:e2e": "playwright test",
    "dev": "npm run content:build && vite",
    "build": "npm run content:build && vite build",
    "preview": "vite preview",
    "build:e2e": "tsx content-build/cli.ts build --content tests/fixtures/content/e2e --fake-audio --out .generated/e2e/content --audio-store .generated/e2e/audio && CONTENT_OUT=.generated/e2e/content vite build --mode e2e --outDir dist-e2e",
    "check": "npm run validate && npm run typecheck && npm run test:content && npm run build && npm run test:e2e",
    "audio:generate": "tsx content-build/cli.ts audio",
    "privacy:check": "tsx scripts/privacy-check.ts",
    "privacy:install-hook": "tsx scripts/install-privacy-hook.ts"
  }
}
